{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "vitest.config.js",
      "README.md",
      "SECURITY.md",
      "GUIA-FIREBASE.md",
      "firestore.rules",
      "firestore.indexes.json",
      ".firebaserc",
      "firebase-debug.log"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}